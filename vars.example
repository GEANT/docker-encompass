# Docker variables
#
# Runtime toggles are stored in DB (Global Settings page):
# UNCLASSIFIED_HOSTS_ENABLED, FEATURE_BRANCH, ENC_OVERLAPPING_DEFINITIONS_ENABLED,
# USE_ENCAPSULE, AUTH_LDAP_ENABLED, LDAP_TLS_SKIP_VERIFY.
#
# PuppetDB, LDAP, and enCapsule routing settings are managed in Global Settings (UI).
#
# common variables
LANGUAGE_CODE = "en-us"
TIME_ZONE = "UTC"
ALLOWED_HOSTS='[".example.org", "orghost", "127.0.0.1"]'
ALLOWED_CIDR_NETS='["83.97.92.0/22"]'
CSRF_TRUSTED_ORIGINS='["https://*.test-int.example.org", "https://*.uat-int.example.org", "https://*.int.example.org", "https://127.0.0.1"]'
CORS_ALLOWED_ORIGINS='["https://encompass.test-int.example.org", "https://encompass.uat-int.example.org", "https://encompass.int.example.org"]'

# django secret key
SECRET_KEY='12345678-1234-1234-1234-1234567890ab'

# dedicated key used to encrypt CSR challengePassword values
# can be either a valid Fernet key or any sufficiently random secret string
CSR_CHALLENGE_KEY="replace-with-a-dedicated-csr-secret"
CSR_API_KEY="replace-with-a-dedicated-api-secret"

# either true or false
DEMO_MODE=false
DEBUG=false
LDAP_AUTH_DEBUG=false   # if true, LDAP authentication debug logs are enabled (may include sensitive details)
ENCOMPASS_LOGGING=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
ENCAPSULE_LOGGING=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LDAP_LOGGING=ERROR      # DEBUG, INFO, WARNING, ERROR, CRITICAL

# NGINX variables
ENC_VIEWER_PASSWORD=""  # leave empty to disable authentication for read-only ENC endpoints (enCompass + enCapsule).
ENC_USE_SSL=false
ENC_SSL_CERT_PATH="/etc/ssl/private/server.crt"
ENC_SSL_KEY_PATH="/etc/ssl/private/server.key"

# enCapsule shared sync token (must be configured identically on encompass + encapsule)
# all other enCapsule sync fan-out settings are managed in Global Settings (UI):
ENCAPSULE_SYNC_TOKEN=""  # required to authenticate against enCapsule /sync endpoints

# MySQL variables
MYSQL_HOST="mysql.example.org"
MYSQL_PORT=3306
MYSQL_DB="encompass"
MYSQL_USER="encompass"
MYSQL_PASSWORD="encompass"

# git settings (only SSH key-based authentication is supported)
# ssh key must NOT be password-protected
GIT_BRANCH=main
GIT_SYNC_MODE=sync  # sync | async
GIT_SYNC_TIMEOUT=30  # seconds for each git/sync command
GIT_SYNC_RETRIES=2
GIT_SYNC_RETRY_DELAY=2  # seconds
GIT_HOST="prod-git01.example.org"
GIT_REPO_PATH="puppet/enc-data.git"
GIT_REPO_USERNAME="gitlab"
SSH_KEY_TYPE="ed25519"  # supported values: rsa | ed25519 | ecdsa
KEY_FILE=/root/.ssh/id_ed25519
KEY_FILE="/root/.ssh/id_$SSH_KEY_TYPE"
GIT_REPO_PRIVATE_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz
wwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwww
qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq
rrrrr=
-----END OPENSSH PRIVATE KEY-----"
