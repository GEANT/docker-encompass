# Dockerfile
#
# https://dockerize.io/guides/python-django-guide
#
# The first instruction is what image we want to base our container on
# We Use an official Python runtime as a parent image
FROM python:3.14-slim-trixie

LABEL author="Massimiliano Adamo <massimiliano.adamo@geant.org>" \
      description="enCapsule is a Highly Available ENC endpoint for enCompass" \
      version="1.0.0"

# Custom cache invalidation: check .gitlab-ci.yml for details
ARG CACHEBUST=1
ARG APP_DEBUG=false

ENV PYTHONUNBUFFERED=1 \
    PIP_ROOT_USER_ACTION=ignore \
    APP_DEBUG=${APP_DEBUG}

# Install all dependencies and cleanup the image, if not in debug mode
COPY files/encompass/requirements.txt /
RUN apt update && \
    apt install -y libsasl2-dev libldap2-dev default-libmysqlclient-dev pkg-config gcc git nginx gettext-base supervisor netcat-openbsd && \
    pip3 install --root-user-action=ignore --disable-pip-version-check --no-compile --upgrade pip setuptools wheel && \
    pip3 install --root-user-action=ignore --no-compile --requirement /requirements.txt && \
    install -d -o root -g root -m 755 /data
RUN if [ "$APP_DEBUG" = "true" ]; then \
        apt install -y vim telnet lsof curl; \
    else \
        apt full-upgrade -y; \
        apt-get --purge remove -y libsasl2-dev libldap2-dev default-libmysqlclient-dev pkg-config gcc; \
        apt clean && \
        rm -rf /root/.cache/pip/* /var/lib/apt/lists/*; \
    fi

COPY files/encompass/supervisord /etc/supervisor/conf.d
COPY files/shared/supervisord /etc/supervisor/conf.d
COPY files/root /root
COPY files/encompass/.templates /root/.templates
COPY --chmod=755 files/encompass/scripts /usr/local/bin
COPY --chmod=755 files/shared/scripts /usr/local/bin
COPY --chmod=644 README.md code/encompass/templates/help.md
COPY --chmod=644 CHANGELOG.md code/encompass/templates/changelog.md
COPY encompass/encompass /code/encompass/encompass
COPY encompass/enc_core /code/encompass/enc_core
COPY encompass/csr_store /code/encompass/csr_store
COPY encompass/templates /code/encompass/templates
COPY encompass/manage.py /code/encompass/manage.py
COPY --chmod=644 files/deployment-stuff/watermark code
COPY --chmod=644 files/deployment-stuff/version code
COPY static code/static/static
ADD https://codeberg.org/api/packages/GEANT/generic/encryptor/latest/encryptor-linux-amd64 /code/static/static/encryptor-linux-amd64
ADD https://codeberg.org/api/packages/GEANT/generic/encryptor/latest/encryptor-linux-arm64 /code/static/static/encryptor-linux-arm64
ADD https://codeberg.org/api/packages/GEANT/generic/encryptor/latest/SHA256SUMS /tmp/encryptor-SHA256SUMS
RUN grep -E 'encryptor-linux-amd64$' /tmp/encryptor-SHA256SUMS | awk '{print $1"  /code/static/static/encryptor-linux-amd64"}' | sha256sum -c - && \
    grep -E 'encryptor-linux-arm64$' /tmp/encryptor-SHA256SUMS | awk '{print $1"  /code/static/static/encryptor-linux-arm64"}' | sha256sum -c - && \
    chmod 0700 /root/.ssh && \
    chmod 0644 /code/static/static/encryptor-* && \
    rm -f /tmp/encryptor-SHA256SUMS

# port explanations: check docker-compose.yml for details
EXPOSE 8080 8081 8443 8444

# runs the development server in debug mode
WORKDIR /code/encompass
CMD ["/usr/local/bin/entrypoint.sh"]
