# Dockerfile
#
# https://dockerize.io/guides/python-django-guide
#
# The first instruction is what image we want to base our container on
# We Use an official Python runtime as a parent image
FROM python:3.14-slim-trixie

LABEL author="Massimiliano Adamo <massimiliano.adamo@geant.org>" \
      description="enCapsule is an agent for enCompass, a tool to provide high availability for the ENC API." \
      version="1.0.0"

# Custom cache invalidation: check .gitlab-ci.yml for details
ARG CACHEBUST=1
ARG APP_DEBUG=false

ENV PYTHONUNBUFFERED=1 \
    PIP_ROOT_USER_ACTION=ignore \
    APP_DEBUG=${APP_DEBUG}

# Install all dependencies and cleanup the image, if not in debug mode
COPY files/encapsule/requirements.txt /
RUN apt update && \
    apt install -y gettext-base git nginx supervisor && \
    pip3 install --root-user-action=ignore --disable-pip-version-check --no-compile --upgrade pip setuptools wheel && \
    pip3 install --root-user-action=ignore --no-compile --only-binary=:all: --requirement /requirements.txt && \
    install -d -o root -g root -m 755 /data
RUN if [ "$APP_DEBUG" = "true" ]; then \
        apt install -y vim telnet lsof curl; \
    else \
        apt full-upgrade -y; \
        apt clean && \
        rm -rf /root/.cache/pip/* /var/lib/apt/lists/*; \
    fi

COPY files/encapsule/supervisord /etc/supervisor/conf.d
COPY files/shared/supervisord /etc/supervisor/conf.d
COPY files/root /root
COPY files/encapsule/.templates /root/.templates
COPY --chmod=755 files/encapsule/scripts /usr/local/bin
COPY --chmod=755 files/shared/scripts /usr/local/bin
COPY encompass/enc_core /code/encapsule/enc_core
COPY encompass/encapsule /code/encapsule/encapsule
COPY encompass/csr_store /code/encapsule/csr_store
ADD https://codeberg.org/api/packages/GEANT/generic/encryptor/latest/encryptor-linux-amd64 /code/encapsule/static/encryptor-linux-amd64
ADD https://codeberg.org/api/packages/GEANT/generic/encryptor/latest/encryptor-linux-arm64 /code/encapsule/static/encryptor-linux-arm64
ADD https://codeberg.org/api/packages/GEANT/generic/encryptor/latest/SHA256SUMS /tmp/encryptor-SHA256SUMS
RUN grep -E 'encryptor-linux-amd64$' /tmp/encryptor-SHA256SUMS | awk '{print $1"  /code/encapsule/static/encryptor-linux-amd64"}' | sha256sum -c - && \
    grep -E 'encryptor-linux-arm64$' /tmp/encryptor-SHA256SUMS | awk '{print $1"  /code/encapsule/static/encryptor-linux-arm64"}' | sha256sum -c - && \
    chmod 0700 /root/.ssh && \
    chmod 0644 /code/encapsule/static/encryptor-* && \
    rm -f /tmp/encryptor-SHA256SUMS

# port explanations: check docker-compose.yml for details
EXPOSE 8081

# runs the development server in debug mode
WORKDIR /code/encapsule
CMD ["/usr/local/bin/entrypoint.sh"]
