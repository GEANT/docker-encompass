Include ~/.ssh/conf.d/*.conf

Host *
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new
    UserKnownHostsFile ~/.ssh/known_hosts
    HashKnownHosts yes
    ControlPath ~/.ssh/cm/%C
    ControlMaster auto
    ControlPersist 8h
    TCPKeepAlive yes
    ServerAliveInterval 120
    ServerAliveCountMax 3
    ConnectTimeout 10
    ConnectionAttempts 3
